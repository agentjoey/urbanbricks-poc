# Neon Postgres connection string (Neon console → project → Connect).
# Local development: copy this file to `.env.local` and paste the real value.
# Production: set DATABASE_URL in the Vercel project environment variables.
# This repo is PUBLIC — never commit the real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Secret for signing the quote-form timing cookie (HMAC-SHA256).
# Generate a strong value for local runs and set it in .env.local.
# Production: set QUOTE_COOKIE_SECRET in Vercel — never commit the real value.
QUOTE_COOKIE_SECRET="REPLACE_WITH_A_STRONG_SECRET_MIN_32_BYTES"
